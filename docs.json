{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SkalePayments",
  "description": "Documentação oficial da API SkalePayments",
  "colors": {
    "primary": "#00E6A8",
    "light": "#00C991",
    "dark": "#00F5B5"
  },
  "logo": {
    "light": "https://skalepayments.com.br/assets/logo-Bg1_ZqGD.png",
    "dark": "https://skalepayments.com.br/assets/logo-Bg1_ZqGD.png"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "Site",
        "href": "https://skalepayments.com.br"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Acessar painel",
      "href": "https://skalepayments.com.br/login"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guias",
        "groups": [
          {
            "group": "Primeiros passos",
            "pages": [
              "index",
              "primeiros-passos/autenticacao",
              "primeiros-passos/primeira-transacao"
            ]
          },
          {
            "group": "Integração",
            "pages": [
              "guias/valores-e-status",
              "guias/webhooks"
            ]
          },
          {
            "group": "Ajuda",
            "pages": ["ajuda/erros"]
          }
        ]
      },
      {
        "tab": "Referência da API",
        "groups": [
          {
            "group": "Documentação da API",
            "pages": ["referencia/introducao"]
          },
          {
            "group": "Transações",
            "pages": [
              "referencia/criar-transacao",
              "referencia/consultar-transacao"
            ]
          },
          {
            "group": "Empresa",
            "pages": ["referencia/dados-da-empresa"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentação",
          "href": "/",
          "icon": "book-open"
        },
        {
          "anchor": "Painel Skale",
          "href": "https://skalepayments.com.br/login",
          "icon": "gauge-high"
        },
        {
          "anchor": "Site",
          "href": "https://skalepayments.com.br",
          "icon": "globe"
        }
      ]
    }
  },
  "redirects": [
    { "source": "/introducao", "destination": "/" },
    { "source": "/transactions", "destination": "/referencia/criar-transacao" },
    { "source": "/get-transaction", "destination": "/referencia/consultar-transacao" },
    { "source": "/get-company", "destination": "/referencia/dados-da-empresa" },
    { "source": "/webhooks", "destination": "/guias/webhooks" }
  ]
}
